OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=magicard_knowledge

# shared secret Laravel must send in the X-Chat-Secret header when calling /chat
CHAT_SHARED_SECRET=

# HTTP Basic auth for the /admin panel (live config + missed-questions log).
# Leave ADMIN_PASSWORD blank to disable the panel entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP settings used to email a full list export when conversations, the
# answer cache, or knowledge gaps reach their configured threshold. Leave
# SMTP_HOST blank to disable notification emails entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=gilad@masteruno.com
